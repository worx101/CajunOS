# CajunOS base-system BusyBox delta.  The build starts from allnoconfig,
# applies this fragment exactly, and then runs olddefconfig.
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_FEATURE_INSTALLER=y
CONFIG_INSTALL_APPLET_SYMLINKS=y
CONFIG_INSTALL_APPLET_HARDLINKS=n
CONFIG_INSTALL_APPLET_SCRIPT_WRAPPERS=n
CONFIG_INSTALL_APPLET_DONT=n
CONFIG_FEATURE_SUID=n
CONFIG_BUSYBOX_EXEC_PATH="/proc/self/exe"
CONFIG_CROSS_COMPILER_PREFIX=""
CONFIG_SYSROOT=""

CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y

CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_GETTY=y
CONFIG_LOGIN=y
CONFIG_FEATURE_SECURETTY=y
CONFIG_HALT=y
CONFIG_KILL=y
CONFIG_KILLALL5=y
CONFIG_SETSID=y

CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_FEATURE_MOUNT_HELPERS=n
CONFIG_FEATURE_MOUNT_CIFS=n
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_SWAPONOFF=y
CONFIG_SWITCH_ROOT=y

CONFIG_HOSTNAME=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_FEATURE_IP_RULE=y
CONFIG_UDHCPC=y
CONFIG_UDHCPC_DEFAULT_SCRIPT="/etc/udhcpc/default.script"
CONFIG_UDHCPC6=n
CONFIG_TC=n

CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_CP=y
CONFIG_CUT=y
CONFIG_DATE=y
CONFIG_DD=y
CONFIG_DF=y
CONFIG_DMESG=y
CONFIG_ECHO=y
CONFIG_ENV=y
CONFIG_FIND=y
CONFIG_GREP=y
CONFIG_HEAD=y
CONFIG_ID=y
CONFIG_INSTALL=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_MD5SUM=y
CONFIG_MKDIR=y
CONFIG_MKFIFO=y
CONFIG_MKNOD=y
CONFIG_MKTEMP=y
CONFIG_MV=y
CONFIG_PRINTF=y
CONFIG_PWD=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SED=y
CONFIG_SHA256SUM=y
CONFIG_SLEEP=y
CONFIG_SORT=y
CONFIG_STAT=y
CONFIG_SYNC=y
CONFIG_TAIL=y
CONFIG_TAR=y
CONFIG_TEST=y
CONFIG_TOUCH=y
CONFIG_TR=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_UNAME=y
CONFIG_UNIQ=y
CONFIG_WC=y
CONFIG_WHOAMI=y
CONFIG_XARGS=y
CONFIG_AWK=y

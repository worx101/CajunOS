# CajunOS native-developer BusyBox additions.  This fragment is applied after
# the complete base-system fragment and retains static linkage.
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_EXPR=y
CONFIG_LINK=y
CONFIG_NPROC=y
CONFIG_PRINTENV=y
CONFIG_TEE=y
CONFIG_USLEEP=y
CONFIG_WHICH=y
CONFIG_YES=y

CONFIG_CMP=y
CONFIG_DIFF=y
CONFIG_PATCH=y

CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_BZIP2=y
CONFIG_BUNZIP2=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
CONFIG_FEATURE_TAR_LONG_OPTIONS=y

# CONFIG_AR is not set
# CONFIG_FEATURE_AR_CREATE is not set

CONFIG_FLOCK=y
CONFIG_MORE=y
CONFIG_TIME=y
CONFIG_TIMEOUT=y

CONFIG_SHA512SUM=y
CONFIG_CKSUM=y

# The optional deployment-volume hook resolves its filesystem identity without
# relying on a kernel device name.  Retain only the ext-family volume probe.
CONFIG_BLKID=y
CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_FEATURE_VOLUMEID_EXT=y
CONFIG_FEATURE_STAT_FILESYSTEM=y
# CONFIG_FEATURE_VOLUMEID_BCACHE is not set
# CONFIG_FEATURE_VOLUMEID_BTRFS is not set
# CONFIG_FEATURE_VOLUMEID_CRAMFS is not set
# CONFIG_FEATURE_VOLUMEID_EROFS is not set
# CONFIG_FEATURE_VOLUMEID_EXFAT is not set
# CONFIG_FEATURE_VOLUMEID_F2FS is not set
# CONFIG_FEATURE_VOLUMEID_FAT is not set
# CONFIG_FEATURE_VOLUMEID_HFS is not set
# CONFIG_FEATURE_VOLUMEID_ISO9660 is not set
# CONFIG_FEATURE_VOLUMEID_JFS is not set
# CONFIG_FEATURE_VOLUMEID_LFS is not set
# CONFIG_FEATURE_VOLUMEID_LINUXRAID is not set
# CONFIG_FEATURE_VOLUMEID_LINUXSWAP is not set
# CONFIG_FEATURE_VOLUMEID_LUKS is not set
# CONFIG_FEATURE_VOLUMEID_MINIX is not set
# CONFIG_FEATURE_VOLUMEID_NILFS is not set
# CONFIG_FEATURE_VOLUMEID_NTFS is not set
# CONFIG_FEATURE_VOLUMEID_OCFS2 is not set
# CONFIG_FEATURE_VOLUMEID_REISERFS is not set
# CONFIG_FEATURE_VOLUMEID_ROMFS is not set
# CONFIG_FEATURE_VOLUMEID_SQUASHFS is not set
# CONFIG_FEATURE_VOLUMEID_SYSV is not set
# CONFIG_FEATURE_VOLUMEID_UBIFS is not set
# CONFIG_FEATURE_VOLUMEID_UDF is not set
# CONFIG_FEATURE_VOLUMEID_XFS is not set

# CONFIG_FEATURE_PREFER_APPLETS is not set
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SH_NOFORK=y
